#!/usr/bin/env python3
"""
Terragrunt Config Builder for Terrateam

This script automatically discovers terragrunt.hcl files in a monorepo and generates
Terrateam configuration with proper dependency tracking, similar to terragrunt-atlantis-config.

Usage:
    This script is designed to be called by Terrateam's config_builder feature.
    It reads the current config from stdin (JSON) and outputs modified config to stdout (JSON).

Environment Variables:
    TERRATEAM_ROOT: Root directory of the repository
"""

import json
import os
import sys
import subprocess
from pathlib import Path
from typing import Dict, Iterable, List, Optional
import re


TERRAGRUNT_DEFAULT_VERSION = '0.75.3'
PYTHON_HCL2_VERSION = os.environ.get('TERRAGRUNT_CONFIG_BUILDER_PYTHON_HCL2_VERSION', '7.3.1')
PYTHON_HCL2_VENV = Path(os.environ.get('TERRAGRUNT_CONFIG_BUILDER_VENV', '/tmp/terragrunt-config-builder-python-hcl2'))


def log(message: str, level: str = "INFO"):
    """
    Log messages to stderr (stdout is reserved for JSON output)

    Args:
        message: The message to log
        level: Log level (INFO, WARN, ERROR, DEBUG)
    """
    print(f"[{level}] {message}", file=sys.stderr)


def ensure_hcl2():
    """
    Lazily install python-hcl2 into a small venv when the builder needs it.
    """
    def add_venv_site_packages(python: Path) -> bool:
        if not python.exists():
            return False

        site_packages = subprocess.check_output([
            str(python),
            '-c',
            'import site; print(site.getsitepackages()[0])'
        ], text=True).strip()

        if site_packages not in sys.path:
            sys.path.insert(0, site_packages)

        try:
            import hcl2  # noqa: F401
            import lark  # noqa: F401
            return True
        except ImportError:
            return False

    try:
        import hcl2  # noqa: F401
        import lark  # noqa: F401
        return
    except ImportError:
        pass

    python = PYTHON_HCL2_VENV / 'bin' / 'python'
    pip = PYTHON_HCL2_VENV / 'bin' / 'pip'

    if add_venv_site_packages(python):
        return

    if not python.exists():
        log(f"Creating python-hcl2 venv at {PYTHON_HCL2_VENV}")
        subprocess.check_call(
            [sys.executable, '-m', 'venv', str(PYTHON_HCL2_VENV)],
            stdout=sys.stderr,
            stderr=sys.stderr
        )

    log(f"Installing python-hcl2=={PYTHON_HCL2_VERSION}")
    subprocess.check_call(
        [
            str(pip),
            'install',
            '--disable-pip-version-check',
            '--no-cache-dir',
            f'python-hcl2=={PYTHON_HCL2_VERSION}'
        ],
        stdout=sys.stderr,
        stderr=sys.stderr
    )

    if not add_venv_site_packages(python):
        raise ImportError(f"python-hcl2=={PYTHON_HCL2_VERSION} was installed but could not be imported")


def get_terragrunt_engine(config: Dict) -> Optional[Dict]:
    """
    Find the first Terragrunt engine configured in the repo config.
    """
    engine = config.get('engine')
    if isinstance(engine, dict) and engine.get('name') == 'terragrunt':
        return engine

    workflows = config.get('workflows', {})
    if isinstance(workflows, dict):
        for workflow in workflows.values():
            if not isinstance(workflow, dict):
                continue

            engine = workflow.get('engine')
            if isinstance(engine, dict) and engine.get('name') == 'terragrunt':
                return engine

    return None


def configure_terragrunt_env(config: Dict):
    """
    Configure tenv/Terragrunt for dependency discovery during config building.
    """
    engine = get_terragrunt_engine(config)

    os.environ.setdefault('TENV_AUTO_INSTALL', 'true')
    os.environ.setdefault('TG_NON_INTERACTIVE', 'true')
    os.environ.setdefault('TERRAGRUNT_NON_INTERACTIVE', 'true')

    # `terragrunt render` fully evaluates each unit's config, including the
    # remote_state block in root.hcl which reads these via get_env(). They're
    # never used for actual state during config building, so provide harmless
    # defaults to prevent EnvVarNotFoundError from failing every render (which
    # would silently drop all terraform.source / module tracking). Real values
    # from the Terrateam runtime take precedence via setdefault.
    os.environ.setdefault('TERRAFORM_STATE_BUCKET_NAME', 'config-builder-placeholder')
    os.environ.setdefault('TERRAFORM_STATE_BUCKET_KMS_KEY_ID', 'config-builder-placeholder')

    # Other get_env() calls without a default that appear in unit inputs/locals.
    # These only feed values that render doesn't actually use during config
    # building, so a placeholder is enough to keep the render from aborting.
    # setdefault means any real value in the environment still wins.
    for placeholder_env in (
        'GLEAN_API_KEY',
        'AWS_IDG_PROD_EXTERNAL_ID',
        'CI_PROJECT_NAME',
        'CI_PROJECT_ROOT_NAMESPACE',
        'CI_SERVER_FQDN',
    ):
        os.environ.setdefault(placeholder_env, 'config-builder-placeholder')

    if not engine:
        os.environ.setdefault('TG_DEFAULT_VERSION', TERRAGRUNT_DEFAULT_VERSION)
        log(f"No Terragrunt engine found; using Terragrunt {TERRAGRUNT_DEFAULT_VERSION} for discovery", "WARN")
        return

    version = engine.get('version') or TERRAGRUNT_DEFAULT_VERSION
    os.environ.setdefault('TG_DEFAULT_VERSION', version)

    if os.environ.get('TERRATEAM_TENV_SERVER_SUPPORT') == 'true' and engine.get('version'):
        # tenv requests go through the server, which cannot list versions, so
        # pin the configured version to stop tenv resolving version
        # constraints from terragrunt.hcl files (see terrat_runner/main.py).
        os.environ.setdefault('TG_VERSION', engine['version'])

    tf_cmd = engine.get('tf_cmd')
    if tf_cmd:
        os.environ.setdefault('TG_TF_PATH', tf_cmd)
        os.environ.setdefault('TERRAGRUNT_TFPATH', tf_cmd)

    log(f"Using Terragrunt {version} for dependency discovery")


def normalize_path(path: str, root_path: str, base_dir: str = "") -> str:
    """
    Normalize a path to repository-relative form.

    Args:
        path: The path to normalize. May be absolute, repo-relative, or
            relative to base_dir (e.g. Terragrunt reports a unit's
            dependencies relative to that unit's own directory).
        root_path: Repository root path.
        base_dir: Directory (repo-relative) that `path` is relative to when
            `path` is not absolute. Used to turn unit-relative dependency
            paths like "../../pca" into repo-relative paths.
    """
    if os.path.isabs(path):
        path = os.path.relpath(path, root_path)
    elif base_dir and (path.startswith("./") or path.startswith("../")):
        # Terragrunt emits a unit's dependencies relative to that unit, so
        # resolve them against the unit's directory before normalizing.
        path = os.path.join(base_dir, path)

    path = os.path.normpath(path)
    if path == ".":
        return ""

    while path.startswith("./"):
        path = path[2:]

    return path


def parse_terragrunt_find_json(stdout: str, root_path: str) -> Dict[str, List[str]]:
    """
    Parse `terragrunt find --dependencies --format=json` output.
    """
    dependency_graph = {}
    units = json.loads(stdout)

    for unit in units:
        if unit.get("type") != "unit":
            continue

        path = normalize_path(unit["path"], root_path)
        dependencies = [
            normalize_path(dep, root_path, base_dir=path)
            for dep in unit.get("dependencies", [])
            if dep
        ]
        dependency_graph[path] = dependencies
        log(f"  {path} depends on: {dependencies}", "DEBUG")

    return dependency_graph


def parse_terragrunt_list_long(stdout: str, root_path: str) -> Dict[str, List[str]]:
    """
    Parse `terragrunt list -l --dependencies` table output.
    """
    dependency_graph = {}
    lines = stdout.strip().split('\n')

    for line in lines[1:]:
        if not line.strip():
            continue

        parts = line.split()
        if len(parts) < 2:
            continue

        path = normalize_path(parts[1], root_path)

        if len(parts) > 2:
            deps_str = ' '.join(parts[2:])
            dependencies = [
                normalize_path(dep.strip(), root_path, base_dir=path)
                for dep in deps_str.split(',')
                if dep.strip()
            ]
        else:
            dependencies = []

        dependency_graph[path] = dependencies
        log(f"  {path} depends on: {dependencies}", "DEBUG")

    return dependency_graph


def discover_terragrunt_files(root_path: str, exclude_patterns: Optional[List[str]] = None) -> List[str]:
    """
    Recursively discover all directories containing terragrunt.hcl files.

    Args:
        root_path: Root directory to start searching from
        exclude_patterns: List of directory patterns to exclude

    Returns:
        List of directory paths (relative to root) containing terragrunt.hcl files
    """
    if exclude_patterns is None:
        exclude_patterns = [
            '.terragrunt-cache',
            '.git',
            '.terraform',
            'node_modules',
            '__pycache__',
        ]

    terragrunt_dirs = []
    root = Path(root_path).resolve()

    log(f"Discovering terragrunt.hcl files in: {root}")

    for dirpath, dirnames, filenames in os.walk(root):
        # Filter out excluded directories (modify dirnames in-place to prevent descent)
        dirnames[:] = [d for d in dirnames if not any(pattern in d for pattern in exclude_patterns)]

        # Check if this directory contains a terragrunt.hcl file
        if 'terragrunt.hcl' in filenames:
            rel_path = os.path.relpath(dirpath, root)
            # Normalize path (convert '.' to empty string for root)
            if rel_path == '.':
                rel_path = ''
            terragrunt_dirs.append(rel_path)
            log(f"Found: {rel_path}/terragrunt.hcl")

    log(f"Discovered {len(terragrunt_dirs)} terragrunt.hcl files")
    return sorted(terragrunt_dirs)


def get_terragrunt_dependencies(root_path: str) -> Dict[str, List[str]]:
    """
    Use terragrunt to get the dependency graph with all interpolations evaluated.

    Args:
        root_path: Root directory of the repository

    Returns:
        Dictionary mapping directory paths to their dependencies
    """
    dependency_graph = {}

    try:
        # Allow timeout to be configured via environment variable
        timeout_seconds = int(os.environ.get('TERRAGRUNT_LIST_TIMEOUT', '100'))
        commands = [
            (
                ['terragrunt', 'find', '--dependencies', '--format=json', '--non-interactive', '--no-color'],
                parse_terragrunt_find_json,
                'terragrunt find --dependencies --format=json'
            ),
            (
                ['terragrunt', 'list', '-l', '--dependencies', '--non-interactive', '--no-color'],
                parse_terragrunt_list_long,
                'terragrunt list -l --dependencies'
            ),
        ]

        for command, parser, description in commands:
            log(f"Running {description} (timeout: {timeout_seconds}s)...")

            result = subprocess.run(
                command,
                cwd=root_path,
                capture_output=True,
                text=True,
                timeout=timeout_seconds
            )

            if result.returncode != 0:
                log(f"{description} failed with return code {result.returncode}", "WARN")
                log(f"stderr: {result.stderr}", "DEBUG")
                continue

            try:
                dependency_graph = parser(result.stdout, root_path)
            except Exception as e:
                log(f"Could not parse {description} output: {e}", "WARN")
                continue

            log(f"Loaded {len(dependency_graph)} units from Terragrunt")
            return dependency_graph

    except subprocess.TimeoutExpired:
        timeout_seconds = int(os.environ.get('TERRAGRUNT_LIST_TIMEOUT', '100'))
        log(f"Terragrunt list timed out after {timeout_seconds} seconds", "WARN")
        log("Continuing without dependency graph from Terragrunt", "WARN")
    except FileNotFoundError:
        log("terragrunt command not found. Please ensure Terragrunt is installed and in PATH.", "ERROR")
    except Exception as e:
        log(f"Error running terragrunt list: {e}", "ERROR")
        import traceback
        traceback.print_exc(file=sys.stderr)

    return dependency_graph


def render_unit_source(root_path: str, dir_path: str, timeout_seconds: int) -> Optional[str]:
    """
    Render a single unit and return its resolved local module dir (repo-relative).

    Returns None if the unit has no source, the source is remote/non-local, or
    render fails. Raises FileNotFoundError if terragrunt is not installed so the
    caller can abort the whole pass.
    """
    unit_dir = os.path.join(root_path, dir_path) if dir_path else root_path

    try:
        result = subprocess.run(
            [
                'terragrunt', 'render', '--json',
                '--disable-dependent-modules',
                '--non-interactive', '--no-color',
            ],
            cwd=unit_dir,
            capture_output=True,
            text=True,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired:
        log(f"terragrunt render timed out for {dir_path or '.'}", "WARN")
        return None
    except FileNotFoundError:
        # terragrunt binary missing; let the caller abort the whole pass.
        raise
    except Exception as e:
        log(f"Error rendering {dir_path or '.'}: {e}", "WARN")
        return None

    if result.returncode != 0:
        log(f"terragrunt render failed for {dir_path or '.'} (rc={result.returncode})", "WARN")
        log(f"stderr: {result.stderr}", "DEBUG")
        return None

    try:
        rendered = json.loads(result.stdout)
    except json.JSONDecodeError as e:
        log(f"Could not parse render JSON for {dir_path or '.'}: {e}", "WARN")
        return None

    terraform = rendered.get('terraform')
    source = terraform.get('source') if isinstance(terraform, dict) else None
    if not isinstance(source, str) or not source:
        return None

    # render resolves get_repo_root() etc. to absolute paths. A source that
    # is still remote (registry/git) won't be an existing local directory.
    module_dir = source.split('//', 1)[0]
    if not os.path.isabs(module_dir):
        module_dir = os.path.normpath(os.path.join(unit_dir, module_dir))

    if not os.path.isdir(module_dir):
        log(f"  Non-local terraform source for {dir_path or '.'}: {source}", "DEBUG")
        return None

    normalized = normalize_path(module_dir, root_path)
    log(f"  Resolved local source for {dir_path or '.'}: {source} -> {normalized}", "DEBUG")
    return normalized


def get_terragrunt_local_sources(root_path: str, terragrunt_dirs: List[str]) -> Dict[str, List[str]]:
    """
    Resolve each unit's terraform.source via `terragrunt render --json`.

    Unlike static HCL parsing, this evaluates includes, locals, and functions
    like get_repo_root(), so sources defined in included *.hcl files (e.g.
    _env/iam.hcl) and built from interpolations are fully resolved. Only local
    (on-disk) module sources are returned, normalized to repo-relative paths.

    Renders run in parallel (one subprocess per unit) since each is independent
    and I/O-bound. Parallelism is configurable via TERRAGRUNT_RENDER_PARALLELISM.

    Args:
        root_path: Repository root path.
        terragrunt_dirs: Repo-relative directories containing terragrunt.hcl.

    Returns:
        Dictionary mapping each directory to a list of repo-relative local
        module source paths (usually one, possibly empty).
    """
    from concurrent.futures import ThreadPoolExecutor, as_completed

    local_sources: Dict[str, List[str]] = {}

    timeout_seconds = int(os.environ.get('TERRAGRUNT_RENDER_TIMEOUT', '30'))

    default_workers = min(16, (os.cpu_count() or 4) * 2)
    max_workers = int(os.environ.get('TERRAGRUNT_RENDER_PARALLELISM', str(default_workers)))
    max_workers = max(1, min(max_workers, len(terragrunt_dirs) or 1))

    log(f"Rendering {len(terragrunt_dirs)} units with {max_workers} workers "
        f"(timeout: {timeout_seconds}s each)...")

    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        future_to_dir = {
            executor.submit(render_unit_source, root_path, dir_path, timeout_seconds): dir_path
            for dir_path in terragrunt_dirs
        }

        for future in as_completed(future_to_dir):
            dir_path = future_to_dir[future]
            try:
                normalized = future.result()
            except FileNotFoundError:
                log("terragrunt command not found; skipping source resolution.", "ERROR")
                return local_sources
            except Exception as e:
                log(f"Unexpected error resolving source for {dir_path or '.'}: {e}", "WARN")
                continue

            if normalized:
                local_sources[dir_path] = [normalized]

    log(f"Resolved local terraform sources for {len(local_sources)} units")
    return local_sources


def iter_hcl_blocks(block_data) -> Iterable[Dict]:
    """
    Yield block bodies from python-hcl2 output, including named block shapes.
    """
    if isinstance(block_data, list):
        for block in block_data:
            yield from iter_hcl_blocks(block)
    elif isinstance(block_data, dict):
        if any(key in block_data for key in ('path', 'source', 'config_path', 'paths')):
            yield block_data

        for key, value in block_data.items():
            if key == '__is_block__':
                continue
            if isinstance(value, dict):
                yield from iter_hcl_blocks(value)
            elif isinstance(value, list):
                yield from iter_hcl_blocks(value)


def hcl_string(value) -> Optional[str]:
    """
    Convert python-hcl2 scalar string values to plain strings.
    """
    if not isinstance(value, str):
        return None

    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
        value = value[1:-1]

    return value


def find_in_parent_folders_target(value: str) -> Optional[str]:
    """
    Extract the target filename from find_in_parent_folders(...).
    """
    match = re.fullmatch(
        r'\$\{\s*find_in_parent_folders\(\s*(?:"([^"]+)"|\'([^\']+)\')?\s*\)\s*\}',
        value
    )

    if not match:
        return None

    return match.group(1) or match.group(2) or 'terragrunt.hcl'


def dirname_find_in_parent_folders_target(value: str) -> Optional[tuple]:
    """
    Parse ${dirname(find_in_parent_folders("X"))}/suffix include paths.

    This is a common idiom for pointing at sibling config directories relative
    to a repo-level anchor file (e.g.
    ${dirname(find_in_parent_folders("root.hcl"))}/_env/iam.hcl).

    Returns:
        (anchor_filename, suffix) where anchor_filename is the file located by
        find_in_parent_folders and suffix is the literal path appended after its
        directory. Returns None if the value doesn't match this pattern.
    """
    match = re.fullmatch(
        r'\$\{\s*dirname\(\s*find_in_parent_folders\(\s*(?:"([^"]+)"|\'([^\']+)\')?\s*\)\s*\)\s*\}'
        r'/(.+)',
        value
    )

    if not match:
        return None

    anchor = match.group(1) or match.group(2) or 'terragrunt.hcl'
    suffix = match.group(3)
    return anchor, suffix


def get_terragrunt_dir_suffix(value: str) -> Optional[str]:
    """
    Parse ${get_terragrunt_dir()}/suffix include paths.

    get_terragrunt_dir() resolves to the directory of the current unit's
    terragrunt.hcl, so the suffix is simply a path relative to base_dir
    (e.g. ${get_terragrunt_dir()}/../../_env/app.hcl).

    Returns the suffix (path relative to the unit dir) or None.
    """
    match = re.fullmatch(
        r'\$\{\s*get_terragrunt_dir\(\s*\)\s*\}/(.+)',
        value
    )

    if not match:
        return None

    return match.group(1)


# Matches read_terragrunt_config(find_in_parent_folders("X")) anywhere in a
# config file (locals, inputs, dependency blocks, etc.). The inner filename is
# captured so it can be located via a parent-folder walk from the unit dir.
_READ_TG_CONFIG_FIP_RE = re.compile(
    r'read_terragrunt_config\(\s*find_in_parent_folders\(\s*'
    r'(?:"([^"]+)"|\'([^\']+)\')?\s*\)\s*\)'
)


def extract_read_terragrunt_config_targets(file_path: str) -> List[str]:
    """
    Extract filenames referenced via read_terragrunt_config(find_in_parent_folders("X")).

    Terragrunt configs frequently pull in sibling/ancestor config files this way
    (e.g. read_terragrunt_config(find_in_parent_folders("region.hcl"))). These are
    real dependencies of the unit but are not include blocks, so they must be
    discovered by scanning the file's contents.

    Args:
        file_path: Absolute path to the .hcl file to scan.

    Returns:
        List of referenced filenames (e.g. ["region.hcl", "account.hcl"]).
        Defaults an omitted argument to "terragrunt.hcl" to match Terragrunt.
    """
    targets: List[str] = []

    try:
        with open(file_path, 'r') as f:
            contents = f.read()
    except OSError:
        return targets

    for match in _READ_TG_CONFIG_FIP_RE.finditer(contents):
        targets.append(match.group(1) or match.group(2) or 'terragrunt.hcl')

    return targets


def find_parent_config(base_dir: str, config_file: str, root_path: str) -> Optional[str]:
    """
    Resolve find_in_parent_folders by walking from base_dir toward root_path.
    """
    root = Path(root_path).resolve()
    current = (root / base_dir).resolve()

    while True:
        parent = current.parent
        if root not in [parent, *parent.parents]:
            return None

        candidate = parent / config_file
        if candidate.exists():
            return normalize_path(str(candidate), str(root))

        if parent == root:
            return None

        current = parent


def resolve_include_path(base_dir: str, path_value: str, root_path: str) -> Optional[str]:
    """
    Resolve Terragrunt include path expressions.
    """
    parent_target = find_in_parent_folders_target(path_value)
    if parent_target:
        resolved = find_parent_config(base_dir, parent_target, root_path)
        if resolved:
            return resolved

        log(f"Could not resolve find_in_parent_folders({parent_target}) from {base_dir}", "WARN")
        return None

    # Handle ${dirname(find_in_parent_folders("X"))}/suffix (e.g. _env/*.hcl).
    dirname_target = dirname_find_in_parent_folders_target(path_value)
    if dirname_target:
        anchor, suffix = dirname_target
        anchor_config = find_parent_config(base_dir, anchor, root_path)
        if anchor_config:
            anchor_dir = os.path.dirname(anchor_config)
            resolved = normalize_path(os.path.join(anchor_dir, suffix), root_path)
            candidate = Path(root_path).resolve() / resolved
            if candidate.exists():
                return resolved
            log(f"Resolved include path does not exist: {path_value} -> {resolved}", "WARN")
            return None

        log(f"Could not resolve dirname(find_in_parent_folders({anchor})) from {base_dir}", "WARN")
        return None

    # Handle ${get_terragrunt_dir()}/suffix (relative to the unit directory).
    dir_suffix = get_terragrunt_dir_suffix(path_value)
    if dir_suffix:
        resolved = resolve_relative_path(base_dir, dir_suffix)
        if resolved:
            candidate = Path(root_path).resolve() / resolved
            if candidate.exists():
                return resolved
            log(f"Resolved include path does not exist: {path_value} -> {resolved}", "WARN")
        return None

    if path_value.startswith('${'):
        log(f"Skipping dynamic include path that cannot be resolved statically: {path_value}", "WARN")
        return None

    return resolve_relative_path(base_dir, path_value)


def collect_read_config_deps(
    base_dir: str,
    root_path: str,
    seed_files: List[str],
) -> List[str]:
    """
    Follow read_terragrunt_config(find_in_parent_folders("X")) references transitively.

    Terragrunt configs (the unit's terragrunt.hcl and any files it includes, e.g.
    _env/*.hcl) frequently read additional config files via
    read_terragrunt_config(find_in_parent_folders("X")). At runtime,
    find_in_parent_folders resolves relative to the *including unit*, so every
    referenced file is a real dependency of the unit and should trigger a plan
    when modified.

    This walks the graph starting from seed_files, scanning each file for such
    references, resolving each target via a parent-folder walk from the unit's
    base_dir, and recursing into newly discovered files. Cycles are avoided by
    tracking visited files.

    Args:
        base_dir: The unit directory (repo-relative), used as the parent-search
            origin to mirror Terragrunt's runtime semantics.
        root_path: Repository root path.
        seed_files: Repo-relative paths of the initial config files to scan
            (typically the unit's terragrunt.hcl plus its resolved includes).

    Returns:
        Sorted list of repo-relative paths for every config file referenced via
        read_terragrunt_config(find_in_parent_folders(...)), excluding the seeds.
    """
    root = Path(root_path).resolve()
    discovered: List[str] = []
    seen_targets = set()
    scanned = set()
    queue = list(seed_files)

    while queue:
        rel_file = queue.pop(0)
        if rel_file in scanned:
            continue
        scanned.add(rel_file)

        abs_file = root / rel_file
        for target in extract_read_terragrunt_config_targets(str(abs_file)):
            resolved = find_parent_config(base_dir, target, root_path)
            if not resolved or resolved in seen_targets:
                continue

            seen_targets.add(resolved)
            discovered.append(resolved)
            log(f"  Found read_terragrunt_config dep: {target} -> {resolved}", "DEBUG")

            # Recurse into the referenced file to follow chained reads.
            if resolved not in scanned:
                queue.append(resolved)

    return sorted(discovered)


def parse_terragrunt_dependencies(file_path: str, base_dir: str, root_path: Optional[str] = None) -> Dict[str, List[str]]:
    """
    Parse a terragrunt.hcl file and extract file patterns for when_modified tracking.

    Dependency blocks are parsed as a fallback for environments where Terragrunt
    discovery cannot run during config building.

    Args:
        file_path: Absolute path to the terragrunt.hcl file
        base_dir: Base directory of the file (for resolving relative paths)
        root_path: Repository root path

    Returns:
        Dictionary with keys:
            - includes: List of parent config file paths (from include blocks)
            - terraform_sources: List of local terraform module paths (from terraform.source)
            - dependencies: List of Terragrunt dependency paths (from dependency blocks)
            - extra_deps: List of extra dependency paths (from locals.extra_atlantis_dependencies)
    """
    result = {
        "includes": [],
        "terraform_sources": [],
        "dependencies": [],
        "extra_deps": []
    }

    if root_path is None:
        file_parent = Path(file_path).resolve().parent
        root_path = str(file_parent)
        if base_dir:
            for _ in Path(base_dir).parts:
                root_path = str(Path(root_path).parent)

    try:
        ensure_hcl2()
        import hcl2
        import lark

        with open(file_path, 'r') as f:
            try:
                parsed = hcl2.load(f)
            except lark.exceptions.LarkError as e:
                log(f"HCL parse error in {file_path}: {e}", "WARN")
                return result

        # Extract include blocks
        if 'include' in parsed:
            for include_config in iter_hcl_blocks(parsed['include']):
                path_value = hcl_string(include_config.get('path'))
                if not path_value:
                    continue

                resolved_path = resolve_include_path(base_dir, path_value, root_path)
                if resolved_path:
                    result['includes'].append(resolved_path)
                    log(f"  Found include: {path_value} -> {resolved_path}", "DEBUG")

        # Extract terraform.source for local modules
        if 'terraform' in parsed:
            for terraform_block in iter_hcl_blocks(parsed['terraform']):
                source = hcl_string(terraform_block.get('source'))
                if source and is_local_source(source):
                    resolved_path = resolve_relative_path(base_dir, source)
                    if resolved_path:
                        result['terraform_sources'].append(resolved_path)
                        log(f"  Found local terraform source: {source} -> {resolved_path}", "DEBUG")

        # Extract dependency "name" { config_path = "../dir" } blocks.
        if 'dependency' in parsed:
            for dependency_block in iter_hcl_blocks(parsed['dependency']):
                config_path = hcl_string(dependency_block.get('config_path'))
                if config_path and '${' not in config_path:
                    resolved_path = resolve_relative_path(base_dir, config_path)
                    if resolved_path:
                        result['dependencies'].append(resolved_path)
                        log(f"  Found dependency: {config_path} -> {resolved_path}", "DEBUG")
                elif config_path:
                    log(f"  Skipping dependency with unresolved interpolation: {config_path}", "WARN")

        # Extract dependencies { paths = ["../dir"] } blocks.
        if 'dependencies' in parsed:
            for dependencies_block in iter_hcl_blocks(parsed['dependencies']):
                paths = dependencies_block.get('paths')
                if not isinstance(paths, list):
                    continue

                for dep_path in paths:
                    dep_path = hcl_string(dep_path)
                    if dep_path and '${' not in dep_path:
                        resolved_path = resolve_relative_path(base_dir, dep_path)
                        if resolved_path:
                            result['dependencies'].append(resolved_path)
                            log(f"  Found dependency path: {dep_path} -> {resolved_path}", "DEBUG")
                    elif dep_path:
                        log(f"  Skipping dependency path with unresolved interpolation: {dep_path}", "WARN")

        # Extract locals.extra_terrateam_dependencies or locals.extra_atlantis_dependencies
        if 'locals' in parsed:
            for locals_block in parsed['locals']:
                # Check for extra_terrateam_dependencies first (preferred naming)
                extra_deps_key = None
                if 'extra_terrateam_dependencies' in locals_block:
                    extra_deps_key = 'extra_terrateam_dependencies'
                elif 'extra_atlantis_dependencies' in locals_block:
                    extra_deps_key = 'extra_atlantis_dependencies'

                if extra_deps_key:
                    extra_deps = locals_block[extra_deps_key]
                    if isinstance(extra_deps, list):
                        for dep in extra_deps:
                            # HCL2 returns lists of lists, so extract the first element if nested
                            if isinstance(dep, list) and len(dep) > 0:
                                dep = dep[0]
                            dep = hcl_string(dep)
                            if dep:
                                resolved_path = resolve_relative_path(base_dir, dep)
                                if resolved_path:
                                    result['extra_deps'].append(resolved_path)
                                    log(f"  Found extra dependency ({extra_deps_key}): {dep} -> {resolved_path}", "DEBUG")

        # Follow read_terragrunt_config(find_in_parent_folders("X")) references in
        # the unit and its included files (e.g. _env/*.hcl reading region.hcl,
        # account.hcl, module.hcl). These are transitive dependencies of the unit
        # and belong in when_modified.file_patterns.
        unit_file = normalize_path(file_path, root_path)
        seed_files = dedupe([unit_file] + result['includes'])
        for read_dep in collect_read_config_deps(base_dir, root_path, seed_files):
            if read_dep not in result['includes']:
                result['includes'].append(read_dep)

    except (ImportError, subprocess.CalledProcessError) as e:
        log(f"Could not install python-hcl2. Cannot parse {file_path}: {e}", "ERROR")
    except Exception as e:
        log(f"Error parsing {file_path}: {e}", "WARN")
        import traceback
        traceback.print_exc(file=sys.stderr)

    return result


def dedupe(values: List[str]) -> List[str]:
    """
    Preserve order while removing duplicates.
    """
    result = []
    seen = set()

    for value in values:
        if value in seen:
            continue

        seen.add(value)
        result.append(value)

    return result


def is_local_source(source: str) -> bool:
    """
    Determine if a terraform source is a local path (not remote).

    Per Terraform's specification, local module paths must start with ./ or ../
    for relative paths, or / for absolute paths. Everything else (registry modules,
    git URLs, HTTP URLs, interpolations, etc.) is treated as remote and should
    NOT be tracked for file changes.

    Args:
        source: The terraform source string

    Returns:
        True if the source is a local file path that should be tracked
    """
    # Per Terraform spec: local paths start with ./ or ../ (relative) or / (absolute)
    # Everything else is remote or unresolvable - skip it
    return source.startswith('./') or source.startswith('../') or source.startswith('/')


def resolve_relative_path(base_dir: str, relative_path: str) -> Optional[str]:
    """
    Resolve a relative path to an absolute path from repository root.

    Args:
        base_dir: The base directory (relative to repo root)
        relative_path: The relative path to resolve

    Returns:
        Path relative to repository root, or None if invalid
    """
    try:
        # Combine base_dir and relative_path
        if base_dir:
            combined = os.path.normpath(os.path.join(base_dir, relative_path))
        else:
            combined = os.path.normpath(relative_path)

        # Remove leading './' if present
        if combined.startswith('./'):
            combined = combined[2:]

        # Remove leading '/' if present (make it relative)
        if combined.startswith('/'):
            combined = combined[1:]

        return combined
    except Exception as e:
        log(f"Error resolving path {base_dir}/{relative_path}: {e}", "WARN")
        return None


def generate_terrateam_config(
    input_config: Dict,
    terragrunt_dirs: List[str],
    all_dependencies: Dict[str, Dict],
    dependency_graph: Dict[str, List[str]]
) -> Dict:
    """
    Generate Terrateam configuration with dirs entries for each terragrunt directory.

    Args:
        input_config: The input configuration from stdin
        terragrunt_dirs: List of terragrunt directory paths
        all_dependencies: Full dependency information for each directory
        dependency_graph: Adjacency dictionary of dependencies

    Returns:
        Modified configuration with generated dirs entries
    """
    output_config = input_config.copy()

    # Ensure dirs key exists
    if "dirs" not in output_config:
        output_config["dirs"] = {}

    for dir_path in terragrunt_dirs:
        deps = all_dependencies.get(dir_path, {})

        # Build file_patterns list. Terragrunt unit directories contain
        # terragrunt.hcl (not raw *.tf/*.tfvars), so only track that here;
        # the actual module .tf files are tracked via resolved terraform.source.
        file_patterns = [
            "${DIR}/terragrunt.hcl",
        ]

        # Add parent config files (includes). Sort for deterministic output.
        for include in sorted(dedupe(deps.get("includes", []))):
            file_patterns.append(include)

        # Add local terraform module sources. Prefer sources resolved via
        # `terragrunt render` (which evaluates includes/locals/get_repo_root),
        # falling back to statically-parsed sources only when render found none.
        module_sources = deps.get("resolved_sources") or deps.get("terraform_sources", [])
        for source in sorted(dedupe(module_sources)):
            # Add glob pattern for all .tf files in the module
            file_patterns.append(f"{source}/**/*.tf")

        # Add extra dependencies. Sort for deterministic output.
        for extra in sorted(dedupe(deps.get("extra_deps", []))):
            file_patterns.append(extra)

        # Prefer the resolved dependency graph from `terragrunt find`/`list`.
        # Only fall back to statically-parsed dependency blocks when Terragrunt
        # discovery produced nothing for this directory, since the static parser
        # (python-hcl2) cannot evaluate interpolations like ${local.foo} and would
        # otherwise leak unresolved paths into file_patterns/depends_on.
        # Sort for deterministic output (Terragrunt's ordering is not stable
        # across runs, and depends_on has set semantics where order is irrelevant).
        resolved_deps = dependency_graph.get(dir_path)
        if resolved_deps:
            direct_deps = sorted(dedupe(resolved_deps))
        else:
            direct_deps = sorted(dedupe(deps.get("dependencies", [])))

        # Add dependency terragrunt.hcl files
        for dep_dir in direct_deps:
            file_patterns.append(f"{dep_dir}/terragrunt.hcl")

        file_patterns = dedupe(file_patterns)

        # Build dir configuration
        dir_config = {
            "tags": ["terragrunt-layered"],
            "when_modified": {
                "file_patterns": file_patterns
            }
        }

        # Add depends_on if there are dependencies
        if direct_deps:
            # Format as Terrateam tag query: "dir:path1 or dir:path2"
            depends_on_query = " or ".join([f"dir:{dep}" for dep in direct_deps])
            dir_config["when_modified"]["depends_on"] = depends_on_query

        # Add to output config (use empty string for root, otherwise the dir path)
        config_key = dir_path if dir_path else "."
        output_config["dirs"][config_key] = dir_config

    # Sort dirs keys for deterministic output regardless of discovery order.
    output_config["dirs"] = {
        key: output_config["dirs"][key]
        for key in sorted(output_config["dirs"])
    }

    return output_config


def main():
    """
    Main entry point for the config builder script.

    Reads JSON config from stdin, processes terragrunt files, and outputs modified JSON to stdout.
    """
    try:
        # Get repository root from environment
        repo_root = os.environ.get('TERRATEAM_ROOT')
        if not repo_root:
            log("ERROR: TERRATEAM_ROOT environment variable not set", "ERROR")
            sys.exit(1)

        log(f"Repository root: {repo_root}")

        # Read input config from stdin
        log("Reading configuration from stdin...")
        input_config = json.load(sys.stdin)
        log(f"Loaded input config with keys: {list(input_config.keys())}")
        configure_terragrunt_env(input_config)

        # Phase 1: Discover terragrunt files
        log("Phase 1: Discovering terragrunt.hcl files...")
        terragrunt_dirs = discover_terragrunt_files(repo_root)

        if not terragrunt_dirs:
            log("No terragrunt.hcl files found. Outputting original config.", "WARN")
            json.dump(input_config, sys.stdout, indent=2)
            return

        # Phase 2: Get dependency graph from Terragrunt
        log("Phase 2: Getting dependency graph from Terragrunt...")
        dependency_graph = get_terragrunt_dependencies(repo_root)

        # Phase 3: Parse file patterns for when_modified
        log("Phase 3: Parsing file patterns from HCL files...")
        all_dependencies = {}
        for dir_path in terragrunt_dirs:
            file_path = os.path.join(repo_root, dir_path, "terragrunt.hcl")
            all_dependencies[dir_path] = parse_terragrunt_dependencies(file_path, dir_path, repo_root)

        # Phase 3b: Resolve each unit's terraform.source via `terragrunt render`
        # so module directories (including those from included *.hcl files and
        # get_repo_root()-based sources) are tracked in when_modified.
        log("Phase 3b: Resolving terraform sources via terragrunt render...")
        local_sources = get_terragrunt_local_sources(repo_root, terragrunt_dirs)
        for dir_path, sources in local_sources.items():
            if dir_path in all_dependencies:
                all_dependencies[dir_path]["resolved_sources"] = sources

        # Phase 4: Generate Terrateam config
        log("Phase 4: Generating Terrateam configuration...")
        output_config = generate_terrateam_config(
            input_config,
            terragrunt_dirs,
            all_dependencies,
            dependency_graph
        )

        # Output final config to stdout
        log("Writing final configuration to stdout...")
        json.dump(output_config, sys.stdout, indent=2)
        log("Config builder completed successfully!")

    except Exception as e:
        log(f"Fatal error: {e}", "ERROR")
        import traceback
        traceback.print_exc(file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
